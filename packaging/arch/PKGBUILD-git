# Maintainer: Iqbal <root_iqbal@local>
pkgname=yaru-git
pkgver=0.1.0.r1.gefa1830
pkgrel=1
pkgdesc="AUR Supply-Chain Security Layer for Arch Linux (VCS master)"
arch=('x86_64')
url="https://github.com/ArayaMusawwah/yaru"
license=('MIT')
depends=('bubblewrap' 'pacman')
makedepends=('cargo' 'git')
optdepends=('paru: for AUR package helper gateway integration')
provides=('yaru')
conflicts=('yaru')
backup=('etc/yaru/config.toml')
source=("git+$url.git#branch=master")
sha256sums=('SKIP')

pkgver() {
    cd yaru
    git describe --long --tags --always 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || echo "0.1.0"
}

prepare() {
    cd yaru
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd yaru
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen
}

check() {
    cd yaru
    cargo test --frozen
}

package() {
    cd yaru
    install -Dm755 "target/release/yaru" "$pkgdir/usr/bin/yaru"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/yaru/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/yaru/README.md"

    install -Dm644 /dev/stdin "$pkgdir/etc/yaru/config.toml" << 'EOF'
[policy]
on_engine_failure = "Warn"
on_warn = "Block"
allow_below = 30
warn_below = 60
quarantine_below = 80

[sandbox]
network_mode = "Strict"

whitelisted_rules = []
EOF
}
